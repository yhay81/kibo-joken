{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kibo-joken",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kibo-joken.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["47 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kibo-joken",
      "database_id": "5a3fa8c1-a553-4d7b-a452-3d84e22797e9",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
